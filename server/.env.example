# Copy this file to .env and fill in real values.
# .env is gitignored; this file is committed so anyone cloning the repo
# knows which variables the server needs.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/whatsapp-clone

# Any long random string. Changing it invalidates all existing tokens.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Must match the Vite dev server exactly, or CORS will block the client
CLIENT_URL=http://localhost:5173

# console = print the OTP to the terminal (development)
# sms     = send a real SMS via Twilio (requires npm i twilio)
OTP_MODE=console

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=